{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}

{% if is_granted("ROLE_ADMIN") or (is_granted("ROLE_MODERATOR") and app.user.category == 'Utilisateur') %}
    {{ include("admin/headerbis.html.twig") }}
{% endif %}

<main class="max-w-6xl mx-auto p-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-12">
        <div class="relative w-full md:w-1/3">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                <i class="fa-solid fa-magnifying-glass text-gray-400"></i>
            </span>
            <input type="text" class="block w-full pl-10 pr-3 py-2 border border-transparent rounded-full bg-gray-100 focus:bg-white focus:ring-2 focus:ring-purple-200 text-sm" placeholder="Rechercher">
        </div>
        <h1 class="text-3xl font-semibold text-gray-800 mt-4 md:mt-0">Utilisateurs</h1>
        <div class="w-1/3 hidden md:block"></div> </div>

    <div class="space-y-6">
        {% for user in users %}
            <div class="flex items-center bg-white p-4 rounded-xl transition hover:bg-gray-50">
                
                <div class="mr-6">
                    <button class="text-gray-400 hover:text-gray-600">
                        <i class="fa-solid fa-ellipsis-vertical text-xl"></i>
                    </button>
                    </div>

                <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-bold text-gray-900 truncate">{{ user.nom }}</h3>
                    <p class="text-sm text-gray-500">Inscription : {{ user.createdAt|date('d/m/Y') }}</p>
                </div>

                <div class="flex flex-col sm:flex-row gap-2 px-4 w-1/4 justify-center">
                    <span class="inline-flex items-center justify-center px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium text-gray-700">
                        Utilisateur
                    </span>
                    {% if user.category is defined and user.category %}
                        <span class="inline-flex items-center justify-center px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 bg-gray-50">
                            Modérateur {{ user.category }}
                        </span>
                    {% endif %}
                </div>

                <div class="flex flex-wrap gap-2 w-1/3 justify-end">
                    <div class="px-4 py-2 rounded-lg border border-gray-200 text-sm text-gray-600 bg-white">
                       {% if user.signalements is defined and user.signalements|length > 0 %}
                            {{ user.signalements|length }} signalements en cours sur cet utilisateur
                        {% else %}
                            Aucun signalement sur cet utilisateur
                        {% endif %}
                    </div>
                    
                    {# Placeholder Statut / Sanction #}
                    {% if loop.index == 3 %} {# Juste pour l'exemple visuel de ta capture #}
                        <div class="px-4 py-2 rounded-lg border border-gray-200 text-sm text-gray-600 bg-white">
                            Bannissement temporaire : 1 mois
                        </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="text-center py-12 bg-gray-50 rounded-xl border-2 border-dashed">
                <p class="text-gray-500">Aucun utilisateur trouvé.</p>
            </div>
        {% endfor %}
    </div>

    <div class="flex justify-center items-center mt-12 space-x-4">
        <button class="text-gray-400 hover:text-gray-800 text-2xl font-light">&lt;</button>
        <div class="flex space-x-2 text-xl">
            <span class="cursor-pointer text-gray-400">1</span>
            <span class="cursor-pointer text-blue-500 font-bold underline">2</span>
            <span class="text-gray-400">...</span>
            <span class="cursor-pointer text-gray-400">3</span>
            <span class="cursor-pointer text-gray-400">4</span>
        </div>
        <button class="text-gray-400 hover:text-gray-800 text-2xl font-light">&gt;</button>
    </div>
</main>

{% endblock %}