{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}

{% if is_granted("ROLE_ADMIN") or (is_granted("ROLE_MODERATOR") and app.user.category == 'Utilisateur') %}
    {{ include("admin/headerbis.html.twig") }}
{% endif %}

<main class="max-w-6xl mx-auto p-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-12">
        <div class="relative w-full md:w-1/3">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                <i class="fa-solid fa-magnifying-glass text-gray-400"></i>
            </span>

            <form action="{{ path('app_admin_utilisateurs') }}" method="GET" class="block w-full pl-10 pr-3 py-2 border border-transparent rounded-full bg-gray-100 focus:bg-white focus:ring-2 focus:ring-purple-200 text-sm">
                <input 
                    type="text" 
                    name="search" 
                    placeholder="Mots clés..." 
                    value="{{ recherche ?? '' }}"
                    class="border-2 border-black px-4 py-2 rounded-lg"
                >
                <button type="submit" class="bg-black text-white px-4 py-2 rounded-lg">
                    Rechercher
                </button>
            </form>

        </div>
        <h1 class="text-3xl font-semibold text-gray-800 mt-4 md:mt-0">Utilisateurs</h1>
        <div class="w-1/3 hidden md:block"></div> </div>

    <div class="space-y-6">
        {% for user in users %}
            <div class="flex items-center bg-white p-4 rounded-xl transition hover:bg-gray-50">
                    
                    <div class="relative inline-block text-left dropdown-container mr-8">
                        <button type="button" class="dropdown-button text-gray-400 hover:text-black focus:outline-none">
                            <span class="text-2xl">•••</span>
                        </button>

                        <div class="dropdown-menu hidden absolute right-0 mt-2 w-48 bg-white border-2 border-black rounded-xl shadow-lg z-50 overflow-hidden">
                            <div class="py-1">
                                {% if is_granted('ROLE_ADMIN') and 'ROLE_MODERATOR' in user.roles %}
                                   <button type="button" class="block px-4 py-2 text-sm text-gray-700 hover:bg-blue-300 flex items-center gap-2"
                                        onclick="toggleForm('form-categorie-{{ user.id }}')">
                                        Modifier la catégorie
                                    </button> 
                                {% endif %}
                                <a href="{{path('app_sanction', {'id' : user.status.id })}}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2">
                                    Appliquer une sanction
                                </a>
                                <a href="{{path('app_mod_status_edit', {'id' : user.status.id })}}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2">
                                    Modifier une sanction
                                </a>
                                {% if is_granted('ROLE_ADMIN') or (is_granted('ROLE_MODERATOR') and app.user.category == "Utilisateur") and 'ROLE_ADMIN' not in user.roles and 'ROLE_MODERATOR' not in user.roles %}  
                                    <a href="{{path('app_utilisateur_edit', {'id' : user.status.id })}}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2">
                                        Modifier l'utilisateur
                                    </a>
                                    
                                    <a href="{{path('app_utilisateur_delete', {'id' : user.status.id })}}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2">
                                        Supprimer l'utilisateur (FAIS PAS CA FAUT QUE JE METTES UN IS_DELETED)
                                    </a>
                                    
                                {% endif %}
                                
                                
                            </div>
                        </div>

                        <form id="form-categorie-{{ user.id }}"
                            action="{{ path('app_edit_categorie', {'id': user.id}) }}"
                            method="POST"
                            class="hidden mt-3 p-3 bg-gray-100 rounded">

                                <input type="hidden" name="categorie" value="{{ user.id }}">

                                <label for="categorie" class="block text-gray-700 mb-1">
                                    Modification de rôle de {{user.nom}}
                                </label>

                                <select id="categorie" name="categorie" required class="border rounded px-2 py-1 w-60">
                                    <option value="">-- Choisir un personnage --</option>
                                    <option value="Utilisateur">Utilisateur</option>
                                    <option value="Personnage">Personnage</option>
    
                                </select>

                                <button type="submit" class="px-2 py-1 bg-green-600 text-white rounded ml-2">
                                    Valider
                                </button>

                                <button type="button"
                                        class="px-2 py-1 bg-gray-400 text-white rounded ml-1"
                                        onclick="toggleForm('form-role-{{ user.id }}')">
                                    Annuler
                                </button>
                        </form>
                    </div>
                
                    <div class="mr-6">
                        {% if user.image %}
                                <img src="{{ asset('uploads/users/' ~ user.image) }}" alt="Avatar" class="w-12 h-12 rounded-full object-cover shadow-xl bg-gray-100">
                        {% else %}
                                <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 shadow-inner">
                                    <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                                </div>
                        {% endif %}
                    </div>
                    
                    <div class="flex-1 min-w-0">

                        <a href="{{path("app_utilisateur",{'id':user.id})}}">
                            <h3 class="text-lg font-bold text-gray-900 truncate hover:underline">{{ user.nom }}</h3>
                        </a>
                        <p class="text-sm text-gray-500">Inscription : {{ user.createdAt|date('d/m/Y') }}</p>
                    </div>
                

                    <div class="flex flex-col sm:flex-row gap-2 px-4 w-1/4 justify-center">
                        {% for role in user.roles %}
                            <span class="inline-flex items-center justify-center px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium text-gray-700">
                            {% if role == "ROLE_USER" %}
                                Utilisateur
                            {% endif %}
                            {% if role == "ROLE_MODERATOR" %}
                                Modérateur
                            {% endif %}
                            {% if role == "ROLE_ADMIN" %}
                                Administrateur
                            {% endif %}
                        
                            {% if user.category is defined and role == "ROLE_MODERATOR" %}
                                 - {{ user.category }}
                            {% endif %}
                            </span>

                        {% endfor %}   
                        
                    </div>

                    <div class="flex flex-wrap gap-2 w-1/3 justify-end">
                        <div class="px-4 py-2 rounded-lg border border-gray-200 text-sm text-gray-600 bg-white">
                        {% if user.signalements is defined and user.signalements|length > 0 %}
                                {{ user.signalements|length }} signalements en cours sur cet utilisateur
                            {% else %}
                                Aucun signalement sur cet utilisateur
                            {% endif %}
                        </div>
                    
                        {% if user.status.status != "Pas de sanction en cours" %} 
                            <div class="px-4 py-2 rounded-lg border border-gray-200 text-sm text-gray-600 bg-white">
                                 {{ user.status.status }} - {{ user.status.type }} jusqu'au {{ user.status.dateFin|date('d/m/Y') }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
        
            <div class="text-center py-12 bg-gray-50 rounded-xl border-2 border-dashed">
                <p class="text-gray-500">Aucun utilisateur trouvé.</p>
            </div>
        {% endfor %}
    </div>

    <div class="flex justify-center items-center mt-12 space-x-4">
        <button class="text-gray-400 hover:text-gray-800 text-2xl font-light">&lt;</button>
        <div class="flex space-x-2 text-xl">
            <span class="cursor-pointer text-gray-400">1</span>
            <span class="cursor-pointer text-blue-500 font-bold underline">2</span>
            <span class="text-gray-400">...</span>
            <span class="cursor-pointer text-gray-400">3</span>
            <span class="cursor-pointer text-gray-400">4</span>
        </div>
        <button class="text-gray-400 hover:text-gray-800 text-2xl font-light">&gt;</button>
    </div>
</main>


{% endblock %}