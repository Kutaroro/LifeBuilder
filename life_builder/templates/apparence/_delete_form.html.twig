<form method="post" action="{{ path('app_apparence_delete', {'id': apparence.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ apparence.id) }}">
    <button class="block px-4 py-2 text-sm text-gray-700 hover:bg-blue-300 flex items-center gap-2">Delete</button>
</form>
