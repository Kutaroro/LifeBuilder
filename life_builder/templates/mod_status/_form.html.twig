{{ form_start(form, {'attr': {'class': 'space-y-6', 'id': 'sanction-form'}}) }}
    
    {# Statut (La liste à puce / Select) #}
    <div>
        <label class="block text-gray-700 font-semibold mb-2">Statut de la sanction</label>
        {{ form_widget(form.status, {'attr': {'class': 'w-full bg-white border border-gray-300 rounded-lg py-2 px-4 focus:ring-2 focus:ring-gray-400 outline-none transition-all'}}) }}
    </div>

    {# Type de sanction #}
    <div>
        <label class="block text-gray-700 font-semibold mb-2">Type / Motif global</label>
        {{ form_widget(form.type, {'attr': {'class': 'w-full border border-gray-300 rounded-lg py-2 px-4 focus:ring-2 focus:ring-gray-400 outline-none transition-all', 'placeholder': 'Ex: Comportement inapproprié, Spam...'}}) }}
    </div>

    {# Date de Fin #}
    <div>
        <label class="block text-gray-700 font-semibold mb-2">Date de fin de la sanction</label>
        {{ form_widget(form.dateFin, {'attr': {'class': 'w-full border border-gray-300 rounded-lg py-2 px-4 focus:ring-2 focus:ring-gray-400 outline-none transition-all'}}) }}
    </div>

    {# Description / Détails #}
    <div>
        <label class="block text-gray-700 font-semibold mb-2">Description / Justification</label>
        {{ form_widget(form.description, {'attr': {'class': 'w-full border border-gray-300 rounded-lg py-2 px-4 h-32 outline-none focus:ring-2 focus:ring-gray-400 resize-none', 'placeholder': 'Précisez les raisons détaillées de la sanction ici...'}}) }}
    </div>

    {# Aperçu si le statut actuel est déjà sanctionné (Optionnel, calqué sur l'image) #}
    {% if mod_status is defined and mod_status.status != "Pas de sanction en cours" %}
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
            Une sanction est actuellement enregistrée : <strong>{{ mod_status.status }}</strong>
        </div>
    {% endif %}

    {# Bouton de validation #}
    <button type="submit" class="w-full bg-black text-white py-4 rounded-xl font-bold mt-8 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg">
        {{ button_label|default('Enregistrer la sanction') }}
    </button>

{{ form_end(form) }}