{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="bg-white min-h-screen flex flex-col items-center justify-center p-4">
    
    <h1 class="text-5xl font-bold text-black mb-12 text-center">Créez votre compte</h1>

    <div class="w-full max-w-md bg-white border border-gray-200 rounded-lg shadow-sm p-8">
        
        {% if form_errors(registrationForm) %}
            <div class="mb-4 p-3 rounded bg-red-100 text-red-700 text-sm">
                {{ form_errors(registrationForm) }}
            </div>
        {% endif %}

        {{ form_start(registrationForm) }}
            
            {# Champ Email #}
            <div class="mb-6">
                {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(registrationForm.email, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-black focus:border-black outline-none transition-all placeholder-gray-400',
                        'placeholder': 'votre@email.com'
                    }
                }) }}
            </div>

            {# Champ Mot de passe #}
            <div class="mb-6">
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(registrationForm.plainPassword, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-black focus:border-black outline-none transition-all',
                        'placeholder': '••••••••'
                    }
                }) }}
            </div>

            {# Case à cocher Conditions #}
            <div class="mb-8 flex items-center gap-3">
                {{ form_widget(registrationForm.agreeTerms, {
                    'attr': {'class': 'w-4 h-4 text-black border-gray-300 rounded focus:ring-black'}
                }) }}
                {{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions d\'utilisation', {'label_attr': {'class': 'text-sm text-gray-700'}}) }}
            </div>

            {# Bouton de soumission #}
            <button type="submit" class="w-full bg-[#2D2D2D] hover:bg-black text-white font-semibold py-3 px-4 rounded-md transition-colors duration-200 mb-6">
                S'inscrire
            </button>

            {# Lien de retour #}
            <div class="text-center">
                <p class="text-sm text-gray-900">
                    Déjà un compte ? 
                    <a href="{{ path('app_login') }}" class="hover:underline decoration-1 font-medium">Connectez-vous.</a>
                </p>
            </div>

        {{ form_end(registrationForm) }}
    </div>
</div>
{% endblock %}