{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="bg-white min-h-screen flex flex-col items-center justify-center p-4">
    
    <h1 class="text-5xl font-bold text-black mb-12 text-center">Créez votre compte</h1>

    <div class="w-full max-w-md bg-white border border-gray-200 rounded-lg shadow-sm p-8">
        
        {% if form_errors(registrationForm) %}
            <div class="mb-4 p-3 rounded bg-red-100 text-red-700 text-sm">
                {{ form_errors(registrationForm) }}
            </div>
        {% endif %}

        {{ form_start(registrationForm) }}
            
            {# Champ Email #}
            <div class="mb-6">
                {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(registrationForm.email, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-black focus:border-black outline-none transition-all placeholder-gray-400',
                        'placeholder': 'votre@email.com'
                    }
                }) }}
                <div class="text-red-600 text-sm mt-2">
                    {{ form_errors(registrationForm.email) }}
                </div>
            </div>

            {# Champ Mot de passe #}
            {# <div class="mb-6">
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(registrationForm.plainPassword, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-black focus:border-black outline-none transition-all',
                        'placeholder': '••••••••'
                    }
                }) }}
            </div> #}
            {# --- CHAMP 1 : LE MOT DE PASSE + JAUGE DE FORCE --- #}
            {# --- CHAMP 1 : LE MOT DE PASSE + EXIGENCES --- #}
            <div class="mb-6">
                {{ form_label(registrationForm.plainPassword['first'], 'Mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                
                {{ form_widget(registrationForm.plainPassword['first'], {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-black focus:border-black outline-none transition-all',
                        'placeholder': '••••••••',
                        'oninput': 'validatePassword(this.value)'
                    }
                }) }}

                {# Liste des critères de sécurité #}
                <div class="mt-3 space-y-1 text-xs text-gray-500">
                    <p class="font-medium mb-1">Le mot de passe doit contenir :</p>
                    <div id="rule-length" class="flex items-center gap-1 transition-colors">
                        <span class="icon">❌</span> Au moins 12 caractères
                    </div>
                    <div id="rule-case" class="flex items-center gap-1 transition-colors">
                        <span class="icon">❌</span> Des majuscules et minuscules
                    </div>
                    <div id="rule-number" class="flex items-center gap-1 transition-colors">
                        <span class="icon">❌</span> Au moins un chiffre
                    </div>
                    <div id="rule-special" class="flex items-center gap-1 transition-colors">
                        <span class="icon">❌</span> Au moins un caractère spécial (@, $, !, %, *, ?, &...)
                    </div>
                </div>

                {# Zone d'affichage de l'erreur Symfony en cas de soumission #}
                <div class="text-red-600 text-sm mt-2">
                    {{ form_errors(registrationForm.plainPassword['first']) }}
                </div>
            </div>

            {# --- CHAMP 2 : LA CONFIRMATION --- #}
            <div class="mb-6">
                {{ form_label(registrationForm.plainPassword['second'], 'Confirmez le mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                
                {{ form_widget(registrationForm.plainPassword['second'], {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-black focus:border-black outline-none transition-all',
                        'placeholder': '••••••••'
                    }
                }) }}

                {# Zone d'affichage de l'erreur de correspondance (ex: "Les mots de passe ne correspondent pas") #}
                <div class="text-red-600 text-sm mt-1">
                    {{ form_errors(registrationForm.plainPassword['second']) }}
                </div>
            </div>

            {# Case à cocher Conditions #}
            <div class="mb-8 flex items-center gap-3">
                {{ form_widget(registrationForm.agreeTerms, {
                    'attr': {'class': 'w-4 h-4 text-black border-gray-300 rounded focus:ring-black'}
                }) }}
                {{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions d\'utilisation', {'label_attr': {'class': 'text-sm text-gray-700'}}) }}
            </div>

            {# Bouton de soumission #}
            <button type="submit" class="w-full bg-[#2D2D2D] hover:bg-black text-white font-semibold py-3 px-4 rounded-md transition-colors duration-200 mb-6">
                S'inscrire
            </button>

            {# Lien de retour #}
            <div class="text-center">
                <p class="text-sm text-gray-900">
                    Déjà un compte ? 
                    <a href="{{ path('app_login') }}" class="hover:underline decoration-1 font-medium">Connectez-vous.</a>
                </p>
            </div>

        {{ form_end(registrationForm) }}
    </div>
</div>



<script>
function validatePassword(password) {
    // 1. Définition des règles et de leurs Regex
    const rules = {
        length: password.length >= 12,
        case: password.match(/[A-Z]/) && password.match(/[a-z]/),
        number: password.match(/[0-9]/),
        special: password.match(/[^A-Za-z0-9]/)
    };

    // 2. Fonction pour mettre à jour visuellement une règle
    function updateRuleVisual(elementId, isSuccess) {
        const el = document.getElementById(elementId);
        if (!el) return;

        const icon = el.querySelector('.icon');

        if (isSuccess) {
            el.classList.remove('text-gray-500', 'text-red-500');
            el.classList.add('text-green-600', 'font-medium');
            if (icon) icon.textContent = '✅';
        } else {
            el.classList.remove('text-green-600', 'font-medium');
            // On colore en rouge léger seulement si l'utilisateur a commencé à taper
            if (password.length > 0) {
                el.classList.add('text-red-500');
            } else {
                el.classList.remove('text-red-500');
                el.classList.add('text-gray-500');
            }
            if (icon) icon.textContent = '❌';
        }
    }

    // 3. Application de la mise à jour sur chaque critère
    updateRuleVisual('rule-length', rules.length);
    updateRuleVisual('rule-case', rules.case);
    updateRuleVisual('rule-number', rules.number);
    updateRuleVisual('rule-special', rules.special);
}
</script>

{% endblock %}