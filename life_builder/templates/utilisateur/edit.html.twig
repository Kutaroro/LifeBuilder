{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<main class="max-w-6xl mx-auto p-8">
    <div class="mb-8">
    {% if is_granted("ROLE_ADMIN") or is_granted("ROLE_MODERATOR") %}
        <a href="{{ path('app_admin_profil',{"id" : utilisateur.id}) }}" class="text-gray-500 hover:text-gray-800 text-sm flex items-center gap-2">
            Retour
        </a>
    {% else %}
        <a href="{{ path('app_utilisateur',{"id" : utilisateur.id}) }}" class="text-gray-500 hover:text-gray-800 text-sm flex items-center gap-2">
            Retour
        </a>
    {% endif %}
        
    </div>

    <h1 class="text-4xl font-bold text-center mb-8">Modifier mon profil</h1>

    <div>
        {{ include('utilisateur/_form.html.twig', {'button_label': 'Submit'}) }}
    </div>
</main>


<script>
    document.addEventListener('change', (event) => {
        // On vérifie si l'élément qui a changé est notre input image
        if (event.target && event.target.id === '{{ form.image.vars.id }}') {
            const [file] = event.target.files;
            const previewImage = document.getElementById('preview-image');
            
            if (file && previewImage) {
                previewImage.src = URL.createObjectURL(file);
            }
        }
    });
</script>

{% endblock %}