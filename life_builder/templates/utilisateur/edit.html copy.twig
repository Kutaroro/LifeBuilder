{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<main class="max-w-6xl mx-auto p-8">
    <div class="mb-12">
        <a href="{{ path('app_admin') }}" class="text-gray-500 hover:text-gray-800 text-sm flex items-center gap-2">
            <i class="fa-solid fa-chevron-left"></i> Retour
        </a>
    </div>

    <h1 class="text-4xl font-bold text-center mb-16">Modifier mon profil</h1>

    <div class="flex flex-col lg:flex-row items-center justify-between gap-16">
        <div class="w-full lg:w-1/2">
            {{ include('utilisateur/_form.html.twig', {'button_label': 'Submit'}) }}
        </div>

        <div class="hidden lg:block w-1/2 flex justify-center">
            <div class="relative w-80 h-80 rounded-full overflow-hidden bg-blue-100 border-8 border-white shadow-xl">
                {# Ici l'image de ton illustration #}
                <img src="{{ asset('images/avatar_illustration.png') }}" alt="Illustration" class="w-full h-full object-cover">
            </div>
        </div>
    </div>
</main>



{% endblock %}