{% extends 'base.html.twig' %}

{% block title %}Profil de {{ utilisateur.nom }}{% endblock %}

{% block body %}
<main class="min-h-screen bg-white py-12 mx-8">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
        
        {# --- SECTION INFO USER (Style demandé) --- #}
        <section class="flex flex-col-reverse md:flex-row items-start justify-between gap-12 mb-20">
            
            {# COLONNE GAUCHE : Textes #}
            <div class="w-full md:w-2/3 pt-4">
                
                {# Nom + Engrenage #}
                <div class="flex items-center gap-4 mb-1">
                    <h1 class="text-5xl font-extrabold text-black tracking-tight">{{ utilisateur.nom }}</h1>
                    
                    {% if app.user == utilisateur %}
                        <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" 
                           class="text-gray-400 hover:text-blue-500 transition-colors duration-200"
                           title="Modifier mon profil">
                            {# Icône Engrenage #}
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8">
                                <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84a.484.484 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22L2.05 8.93a.49.49 0 0 0 .12.61l2.03 1.58c-.05.3-.07.63-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.27.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                            </svg>
                        </a>
                    {% elseif is_granted("ROLE_ADMIN") or is_granted("ROLE_MODERATOR") %}
                        <div class="dropdown-container">
                            <button type="button" class="dropdown-button text-gray-400 hover:text-blue-500 transition-colors duration-200"
                                    title="Gérer le profil de {{ utilisateur.nom }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8">
                                    <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84a.484.484 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22L2.05 8.93a.49.49 0 0 0 .12.61l2.03 1.58c-.05.3-.07.63-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.27.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                </svg>
                            </button>

                            <div class="dropdown-menu hidden absolute  mt-2 w-48 bg-white border-2 border-black rounded-xl shadow-lg z-50 overflow-hidden">
                                <div class="py-1">
                
                                    <a href="{{path('app_mod_status_edit', {'id' :utilisateur.status.id })}}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2">
                                        Appliquer une sanction
                                    </a>
                                    <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2">
                                        Bannir l'utilisateur (Pas actif)
                                   </a>
                                    
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# Rôle (en gris, style minimaliste) #}
                <div class="mb-8">
                    {% if "ROLE_ADMIN" in utilisateur.roles %}
                        <span class="text-xl text-gray-400 font-medium">Administrateur</span>
                    {% elseif "ROLE_MODERATOR" in utilisateur.roles %}
                        <span class="text-xl text-gray-400 font-medium">Modérateur</span>
                    {% else %}
                        <span class="text-xl text-gray-400 font-medium">Utilisateur</span>
                    {% endif %}
                </div>
                <div>
                    {% if utilisateur.status.status != "Pas de sanction en cours" %}
                        <span class="text-xl text-red-500 font-medium">{{ utilisateur.status.status }}</span>
                    {% endif %}
                </div>

                <div class="mt-6 p-4 bg-gray-50 rounded-xl border border-gray-100">
                    <h2 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-2">À propos</h2>
                    <p class="text-gray-700 leading-relaxed italic">
                        "{{ utilisateur.description ?: 'Aucune description disponible.' }}"
                    </p>
                </div>

            </div>

           
            <div class="w-full md:w-1/3 flex justify-center md:justify-end">
                {% if utilisateur.image %}
                     <img src="{{ asset('uploads/users/' ~ utilisateur.image) }}" alt="Avatar" class="w-56 h-56 rounded-full object-cover shadow-xl bg-gray-100">
                {% else %}
                    {# Placeholder si pas d'image #}
                    <div class="w-72 h-72 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 shadow-inner">
                        <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                    </div>
                {% endif %}
            </div>
        </section>


        {# --- SECTION TITRE & BOUTONS --- #}
        <section class="mb-8">
            <div class="flex gap-6 pb-2 mb-6">
                <h2 class="text-3xl font-bold text-black items-baseline border-b-2 border-black">Personnages récents</h2>
                <a href="{{ path('app_personnage_index', {'id': utilisateur.id}) }}" class="mt-4 text-sm font-semibold text-gray-600 underline hover:text-black decoration-2 underline-offset-4">
                    (voir tous les personnages)
                </a>
            </div>
            
            {% if app.user == utilisateur %}
                <div>
                    <a href="{{ path('app_personnage_new') }}" class="inline-flex items-center gap-2 px-6 py-2 rounded-full border border-gray-300 text-gray-600 hover:border-black hover:text-black transition-colors bg-white">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        <span class="font-medium">Ajouter un personnage</span>
                    </a>
                </div>
            {% endif %}
        </section>


        <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {% for personnage in utilisateur.personnages %}
                <a href="{{ path('app_personnage_show', {'id': personnage.id}) }}">
                    <div class="flex flex-row bg-white border-2 border-gray-100 rounded-xl overflow-hidden hover:border-black transition-colors duration-300 cursor-pointer h-48">
                        {# Image Personnage #}
                        <div class="w-1/3 bg-gray-100">
                            {% if personnage.image %}
                                <img src="{{ asset('uploads/personnages/' ~ personnage.image) }}" alt="{{ personnage.nom }}" class="w-full h-full object-cover">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center text-gray-300">
                                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                </div>
                            {% endif %}
                        </div>
                        
                        {# Infos Personnage #}
                        <div class="w-2/3 p-6 flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-start">
                                    <h3 class="text-2xl font-bold text-gray-900 mb-1">{{ personnage.nom }}</h3>
                                </div>
                                <p class="text-gray-600 line-clamp-3 leading-snug">
                                    {{ personnage.description }}
                                </p>
                            </div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </section>

    </div>
</main>


<script>
document.addEventListener('click', function(event) {
        // 1. On cherche si on a cliqué sur un bouton dropdown
        const btn = event.target.closest('.dropdown-button');
        const container = event.target.closest('.dropdown-container');

        // Si on clique sur un bouton, on bascule son menu
        if (btn && container) {
            const menu = container.querySelector('.dropdown-menu');
            
            // On ferme les autres menus ouverts avant d'ouvrir celui-ci
            document.querySelectorAll('.dropdown-menu').forEach(m => {
                if (m !== menu) m.classList.add('hidden');
            });

            menu.classList.toggle('hidden');
            event.stopPropagation(); // Empêche la fermeture immédiate
        } 
        // 2. Si on clique n'importe où ailleurs, on ferme tous les menus
        else {
            document.querySelectorAll('.dropdown-menu').forEach(m => {
                m.classList.add('hidden');
            });
        }
    });

</script>
{% endblock %}