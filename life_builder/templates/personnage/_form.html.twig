{{ form_start(form, {'attr': {'class': 'space-y-6', 'id': 'personnage-form'}}) }}
            
            {# Nom #}
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Nom du personnage</label>
                {{ form_widget(form.nom, {'attr': {'class': 'w-full border border-gray-300 rounded-lg py-2 px-4 focus:ring-2 focus:ring-gray-400 outline-none transition-all', 'placeholder': 'Ex: John Fantasy'}}) }}
            </div>

            {# Catégories #}
            <div class="tag-container" data-field="categories">
                <label class="block text-gray-700 font-semibold mb-2">Catégories</label>
                <div class="relative flex items-center">
                    <input type="text" class="tag-visual-input w-full border border-gray-300 rounded-lg py-2 px-4 pr-12 outline-none focus:ring-2 focus:ring-gray-400" placeholder="Ex: Final Fantay, Héro, Antagoniste...">
                    <button type="button" class="add-tag-btn absolute right-4 text-2xl text-gray-400 hover:text-black focus:outline-none">+</button>
                </div>
                <div class="tag-list flex flex-wrap gap-2 mt-3"></div>
                {{ form_widget(form.categories_hidden, {'attr': {'class': 'tag-hidden-input hidden'}}) }}
            </div>

            {# Tags #}
            <div class="tag-container" data-field="tags">
                <label class="block text-gray-700 font-semibold mb-2">Tags</label>
                <div class="relative flex items-center">
                    <input type="text" class="tag-visual-input w-full border border-gray-300 rounded-lg py-2 px-4 pr-12 outline-none focus:ring-2 focus:ring-gray-400" placeholder="Ex: Grand, Cheveux blond, juste une phrase comme ça sinon. ">
                    <button type="button" class="add-tag-btn absolute right-4 text-2xl text-gray-400 hover:text-black focus:outline-none">+</button>
                </div>
                <div class="tag-list flex flex-wrap gap-2 mt-3"></div>
                {{ form_widget(form.tags_hidden, {'attr': {'class': 'tag-hidden-input hidden'}}) }}
            </div>

            {# Description #}
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Description</label>
                {{ form_widget(form.description, {'attr': {'class': 'w-full border border-gray-300 rounded-lg py-2 px-4 h-32 outline-none focus:ring-2 focus:ring-gray-400 resize-none', 'placeholder': 'Parlez nous de votre personnnage...'}}) }}
            </div>

            {# Visibilité #}
            <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                {{ form_widget(form.isPublic, {'attr': {'class': 'w-5 h-5 rounded border-gray-300'}}) }}
                <label class="text-gray-700 text-sm font-medium cursor-pointer">Rendre ce personnage public</label>
            </div>

            {# Image Principale #}
            <div class="pt-6 border-t">
                <label class="block text-gray-700 font-semibold mb-3">Image de profil</label>
                <div class="flex items-center gap-4">
                    <label class="cursor-pointer bg-gray-800 hover:bg-black text-white px-5 py-2 rounded-lg transition-all text-sm flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-8l-4-4m0 0L8 8m4-4v12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                        Importer
                        {{ form_widget(form.image, {'attr': {'class': 'image-preview-input hidden', 'accept': 'image/*'}}) }}
                    </label>
                    {# Dans la section Image Principale de _form.html.twig #}
                    <div id="main-preview">
                        {% if personnage.image %}
                            <div class="relative w-20 h-20 rounded-lg overflow-hidden shadow-inner">
                                <img src="{{ asset('uploads/personnages/' ~ personnage.image) }}" class="w-full h-full object-cover">
                            </div>
                        {% endif %}
                    </div>
                </div>
                {% if form_errors(form.image) %}
                    <div class="text-red-500 text-sm mt-2 font-medium">
                        {{ form_errors(form.image) }}
                    </div>
                {% endif %}
     
            </div>

            {# Galerie #}
            <div class="pt-6 border-t">
                <label class="block text-gray-700 font-semibold mb-3">Galerie d'images (max 5)</label>
                <label class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50 hover:border-gray-400 transition-all">
                    <span class="text-gray-500 text-sm">Cliquer pour ajouter des images</span>
                    {{ form_widget(form.imagesSecondaires, {'attr': {'class': 'gallery-preview-input hidden', 'accept': 'image/*', 'multiple': 'multiple'}}) }}
                </label>
                {% if form_errors(form.imagesSecondaires) %}
                    <div class="text-red-500 text-sm mt-2 font-medium">
                        {{ form_errors(form.imagesSecondaires) }}
                    </div>
                {% endif %}
                <div id="gallery-preview" class="flex flex-wrap gap-3 mt-4">
                {# Affichage des images déjà enregistrées en base #}
                {% if personnage is defined and personnage.imagesSecondaires %}
                    {% for img in personnage.imagesSecondaires %}
                        <div class="relative w-20 h-20 rounded-lg overflow-hidden border border-gray-200 group">
                            <img src="{{ asset('uploads/personnages/' ~ img) }}" class="w-full h-full object-cover opacity-70">
                            <div class="absolute inset-0 flex items-center justify-center bg-black/20 text-[10px] text-white font-bold">
                                En ligne
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
            </div>

            <button type="submit" class="w-full bg-black text-white py-4 rounded-xl font-bold mt-8 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg">
                Finaliser la création
            </button>

        {{ form_end(form) }}