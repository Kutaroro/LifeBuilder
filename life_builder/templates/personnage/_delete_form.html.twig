<form method="post" action="{{ path('app_personnage_delete', {'id': personnage.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce personnage ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ personnage.id) }}">
    <button class="w-full text-left block px-4 py-2 text-sm text-red-600 hover:bg-gray-100 font-medium">
        Supprimer le personnage
    </button>
</form>