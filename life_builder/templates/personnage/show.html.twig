{% extends 'base.html.twig' %}

{% block title %}Personnage - {{ personnage.nom }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 space-y-10">
    <h1 class="text-4xl font-bold text-gray-800 mb-6">{{ personnage.nom }}</h1>

    {# --- SECTION INFORMATIONS --- #}
    <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-2xl font-bold text-gray-700 mb-4">Informations</h2>
        <div class="flex flex-col md:flex-row gap-6">
            <img src="{{ personnage.image }}" alt="{{ personnage.nom }}" class="w-32 h-32 object-cover rounded shadow">
            <table class="table-auto w-full text-left border-collapse">
                <tbody>
                    <tr class="border-b"><th class="py-2 px-4 text-gray-600">ID</th><td>{{ personnage.id }}</td></tr>
                    <tr class="border-b"><th class="py-2 px-4 text-gray-600">Nom</th><td>{{ personnage.nom }}</td></tr>
                    <tr><th class="py-2 px-4 text-gray-600">Description</th><td>{{ personnage.description }}</td></tr>
                </tbody>
            </table>
            <a href="{{ path('app_personnage_edit', {'id': personnage.id}) }}">
                {% if app.user == personnage.utilisateur %}
                    <svg class="w-6 h-6 " aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M9.586 2.586A2 2 0 0 1 11 2h2a2 2 0 0 1 2 2v.089l.473.196.063-.063a2.002 2.002 0 0 1 2.828 0l1.414 1.414a2 2 0 0 1 0 2.827l-.063.064.196.473H20a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-.089l-.196.473.063.063a2.002 2.002 0 0 1 0 2.828l-1.414 1.414a2 2 0 0 1-2.828 0l-.063-.063-.473.196V20a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2v-.089l-.473-.196-.063.063a2.002 2.002 0 0 1-2.828 0l-1.414-1.414a2 2 0 0 1 0-2.827l.063-.064L4.089 15H4a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h.09l.195-.473-.063-.063a2 2 0 0 1 0-2.828l1.414-1.414a2 2 0 0 1 2.827 0l.064.063L9 4.089V4a2 2 0 0 1 .586-1.414ZM8 12a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" clip-rule="evenodd"/>
                    </svg>
                 {% endif %}
            </a>
        </div>
    </div>

    {# --- SECTION PERSONNAGES LIÉS --- #}
    <div class="bg-white shadow rounded-lg p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-gray-700">Personnages liés</h2>
            {% if app.user == personnage.utilisateur %}
                <button class="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700" onclick="toggleForm('form-personnage-lie')">
                    Ajouter un lien
                </button>
            {% endif %}
        </div>

        <form id="form-personnage-lie" action="{{ path('app_add_persoLie') }}" method="POST" class="hidden mb-6 p-4 bg-gray-100 rounded">
            <input type="hidden" name="personnageId" value="{{ personnage.id }}">
            <select name="persoLies" required class="border rounded px-2 py-1 w-64">
                <option value="">-- Choisir un personnage --</option>
                {% for pers in personnagesPublics %}
                    <option value="{{ pers.id }}">{{ pers.nom }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="px-4 py-1 bg-green-600 text-white rounded ml-2">Lier</button>
        </form>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for item in personnage.persoLies %}
                <a href="{{ path('app_personnage_show', {'id': item.id}) }}" class="block p-4 border rounded hover:bg-gray-50 transition">
                    <div class="flex flex-row space-x-4">
                        {% if item.image %}
                            <img src="{{ item.image }}" alt="{{ item.nom }}" class="w-16 h-16 object-cover rounded shadow">
                        {% endif %}
                        <div>
                            <strong class="text-gray-900">{{ item.nom }}</strong>
                            <p class="text-sm text-gray-600">{{ item.description }}</p>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>

    <div class="bg-white shadow rounded-lg p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-gray-700">Dernières histoires <a class="text-sm" href="{{ path('app_histoire_index_personnage', {'id': personnage.id}) }}">> Voir tout</a></h2>  
            {% if app.user == personnage.utilisateur %}
                <a href="{{ path('app_histoire_new', {'id': personnage.id}) }}"
                class="px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700">
                Créer une histoire
                </a>
            {% endif %}
        </div>

        <div class="flex flex-row space-x-4 mb-6 overflow-x-auto">
            {% for categorie in categories %}
                <a href="{{ path('app_personnage_show', {'id': personnage.id, 'category': categorie.categorie}) }}" 
                class="border border-xl border-black hover:text-white text-xs rounded-full rounded p-3 hover:bg-black"> 
                {{categorie.categorie}} </a>
            {% endfor %}
        

        </div>

        <div class="space-y-4">
            {% for item in histoires %}
                <div class="border rounded p-4 shadow-sm bg-gray-50">
                    <div class="flex justify-between items-center mb-2">
                        <strong class="text-gray-900">{{ item.titre }}</strong>
                        {% if app.user == personnage.utilisateur %}
                            <button type="button"
                                    class="px-2 py-1 bg-blue-600 text-white rounded text-sm"
                                    onclick="toggleForm('form-histoire{{ item.id }}')">
                                Modifier l'ordre
                            </button>
                            <a href="{{ path('app_histoire_edit', {'id': item.id}) }}" 
                               class="ml-2 px-2 py-1 bg-yellow-600 text-white rounded text-sm hover:bg-yellow-700">
                                Éditer
                            </a>
                        {% endif %}
                    </div>
                    <p class="text-gray-700">{{ item.description }}</p>

                    
                    <form id="form-histoire{{ item.id }}" 
                          action="{{ path('app_personnage_histoire_ordre', {'personnageId': personnage.id, 'histoireId': item.id}) }}" 
                          method="POST"
                          class="hidden mt-3 p-3 bg-gray-100 rounded">
                        <label for="ordreAffichage-{{ item.id }}" class="block text-gray-700 mb-1">
                            Nouvel ordre d'affichage:
                        </label>
                        <input type="number" id="ordreAffichage-{{ item.id }}" name="ordreAffichage"
                               min="1" required
                               class="border rounded px-2 py-1 w-20">
                        <button type="submit" class="px-2 py-1 bg-green-600 text-white rounded ml-2">Valider</button>
                        <button type="button" class="px-2 py-1 bg-gray-400 text-white rounded ml-1"
                                onclick="toggleForm('form-histoire{{ item.id }}')">Annuler</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="bg-white shadow rounded-lg p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-gray-700">Apparences <a class="text-sm" href="{{ path('app_apparence_index_personnage', {'id': personnage.id}) }}">> Gérer les apparences</a></h2>
            {% if app.user == personnage.utilisateur %}
                <a href="{{ path('app_apparence_new', {'id': personnage.id}) }}"
                class="px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700">
                Créer une apparence
                </a>
            {% endif %}
        </div>

        <div class="space-y-4">
            {% for item in apparences %}
                <div class="border rounded p-4 shadow-sm bg-gray-50">
                    <div class="flex justify-between items-center mb-2">
                        <strong class="text-gray-900">{{ item.titre }}</strong>
                        {% if app.user == personnage.utilisateur %}
                            <button type="button"
                                    class="px-2 py-1 bg-blue-600 text-white rounded text-sm"
                                    onclick="toggleForm('form-apparence{{ item.id }}')">
                                Modifier l'ordre
                            </button>
                            <a href="{{ path('app_apparence_edit', {'id': item.id}) }}" 
                               class="ml-2 px-2 py-1 bg-yellow-600 text-white rounded text-sm hover:bg-yellow-700">
                                Éditer
                            </a>
                        {% endif %}
                    </div>
                    <p class="text-gray-700">{{ item.description }}</p>
                    <div class="flex space-x-2 mt-2">
                        {% for image in item.images %}
                            <img src="{{ image }}" alt="Apparence Image" class="w-20 h-20 object-cover rounded shadow">
                        {% endfor %}
                    </div>

                    
                    <form id="form-apparence{{ item.id }}" 
                          action="{{ path('app_personnage_apparence_ordre', {'personnageId': personnage.id, 'apparenceId': item.id}) }}" 
                          method="POST"
                          class="hidden mt-3 p-3 bg-gray-100 rounded">
                        <label for="ordreAffichage-{{ item.id }}" class="block text-gray-700 mb-1">
                            Nouvel ordre d'affichage:
                        </label>
                        <input type="number" id="ordreAffichage-{{ item.id }}" name="ordreAffichage"
                               min="1" required
                               class="border rounded px-2 py-1 w-20">
                        <button type="submit" class="px-2 py-1 bg-green-600 text-white rounded ml-2">Valider</button>
                        <button type="button" class="px-2 py-1 bg-gray-400 text-white rounded ml-1"
                                onclick="toggleForm('form-apparence{{ item.id }}')">Annuler</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </div>




    {# --- SECTION COMMENTAIRES --- #}
<div class="bg-white shadow rounded-lg p-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Commentaires</h2>

    {% if is_granted('ROLE_USER') %}
        <button class="mb-6 px-4 py-2 bg-blue-600 text-white rounded" onclick="toggleForm('form-commentaire-principal')">
            Écrire un commentaire
        </button>
        <div id="form-commentaire-principal" class="hidden mb-8 p-4 border rounded bg-gray-50">
            {{ include('commentaire/_form.html.twig', {'form': form}) }}
        </div>
    {% endif %}

    <div class="space-y-6">
        {% for commentaire in commentaires %}
            {% if commentaire.commentaire is null %}
                <div class="p-4 border rounded-lg bg-white shadow-sm" id="comment-{{ commentaire.id }}">
                    
                  
                    <div class="comment-content-block">
                        <div class="flex justify-between text-sm text-gray-500 mb-2">
                            <span class="font-bold text-gray-900">{{ commentaire.utilisateur ? commentaire.utilisateur.nom : 'Anonyme' }}</span>
                            <span>{{ commentaire.date|date('d/m/Y H:i') }}</span>
                        </div>
                        <p class="text-gray-800">{{ commentaire.description }}</p>

                        {% if is_granted('ROLE_USER') %}
                            <button class="mt-2 text-blue-600 text-sm font-medium hover:underline" 
                                    onclick="setupReply(event, {{ commentaire.id }}, '{{ commentaire.utilisateur ? commentaire.utilisateur.nom : 'Anonyme' }}')">
                                Répondre
                            </button>
                        {% endif %}
                        <a href="{{ path('app_commentaire_delete', {'id': commentaire.id}) }}" class="ml-4 text-red-600 text-sm font-medium hover:underline"> Supprimer </a>
                            
                    </div>

                    
                    <div class="mt-4 ml-8 space-y-3 border-l-2 border-gray-100 pl-4">
                        {% for rep in commentaire.reponses %}
                            <div class="text-sm p-3 bg-gray-50 rounded comment-content-block">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <span class="font-bold text-gray-900">{{ rep.utilisateur ? rep.utilisateur.nom : 'Anonyme' }}</span> 
                                        <span class="text-gray-400 text-xs ml-2">{{ rep.date|date('d/m/Y H:i') }}</span>
                                    </div>
                                </div>
                                <p class="mt-1 text-gray-700">
                                    <span class="text-blue-500 font-medium">@{{ rep.mentionedUtilisateur ? rep.mentionedUtilisateur.nom : (commentaire.utilisateur ? commentaire.utilisateur.nom : 'Anonyme') }}</span> 
                                    {{ rep.description }}
                                </p>
                                
                                {% if is_granted('ROLE_USER') %}
                                    <button class="text-xs text-gray-500 hover:text-blue-600 mt-1" 
                                            onclick="setupReply(event, {{ commentaire.id }}, '{{ rep.utilisateur ? rep.utilisateur.nom : 'Anonyme' }}')">
                                        Répondre
                                    </button>
                                {% endif %}
                                <a href="{{ path('app_commentaire_delete', {'id': rep.id}) }}" class="ml-4 text-red-600 text-sm font-medium hover:underline"> Supprimer</a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% else %}
            <p class="text-gray-500 italic text-center">Aucun commentaire pour le moment.</p>
        {% endfor %}
    </div>
</div>

{# --- LE FORMULAIRE CACHÉ (Injecté par JS) --- #}
<div id="global-reply-form" class="hidden p-4 bg-blue-50 border border-blue-200 rounded-lg my-4 mx-4">
    <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-bold text-blue-800" id="reply-to-title"></span>
        <button type="button" class="text-red-500 text-xs font-bold" onclick="cancelReply()">Annuler</button>
    </div>
    {{ form_start(formR) }}
        <input type="hidden" name="commentaireID" id="input-parent-id">
        {{ form_widget(formR) }}
        <button type="submit" class="mt-2 px-4 py-1 bg-blue-600 text-white rounded shadow">Envoyer la réponse</button>
    {{ form_end(formR) }}
</div>

<script>
    function toggleForm(id) {
        const el = document.getElementById(id);
        el.classList.toggle('hidden');
    }

    function setupReply(event, parentId, parentName) {
        const form = document.getElementById('global-reply-form');
        const title = document.getElementById('reply-to-title');
        const inputId = document.getElementById('input-parent-id');

        // On trouve le bloc de texte le plus proche du bouton cliqué
        const clickedButton = event.currentTarget;
        const commentBlock = clickedButton.closest('.comment-content-block');

        title.innerText = "Répondre à " + parentName;
        inputId.value = parentId;
        
        form.classList.remove('hidden');

        // Déplace le formulaire juste après le bloc de texte (parent ou enfant)
        commentBlock.after(form);

        // Focus sur le textarea pour gagner du temps
        const textarea = form.querySelector('textarea');
        if (textarea) textarea.focus();
    }

    function cancelReply() {
        const form = document.getElementById('global-reply-form');
        form.classList.add('hidden');
        document.body.appendChild(form); // Remet le formulaire au chaud en bas de page
    }
</script>

{% endblock %}